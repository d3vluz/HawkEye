# ================================================================
# Copie este arquivo para .env (comando: ``cp .env.example .env``) 
# e modifique as variáveis de ambiente conforme necessário.
# ================================================================

# PostgreSQL
POSTGRES_USER=hawkeye_user
POSTGRES_PASSWORD=hawkeye_pass
POSTGRES_DB=hawkeye_db

# MinIO
MINIO_ACCESS_KEY=minioadmin          # mínimo 3 caracteres
MINIO_SECRET_KEY=minioadmin          # mínimo 8 caracteres
MINIO_BUCKET_REVIEW=review
MINIO_BUCKET_PERMANENT=permanent

# Backend API (NestJS)
DATABASE_URL=postgresql://hawkeye_user:hawkeye_pass@db:5432/hawkeye_db
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
CV_WORKER_URL=http://worker:8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
